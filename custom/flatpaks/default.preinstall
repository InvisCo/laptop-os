# laptop-os Flatpak preinstall
# These will be installed on first boot via flatpak-preinstall.service

[Flatpak Preinstall org.gnome.gitlab.somas.Apostrophe]
Branch=stable

[Flatpak Preinstall eu.betterbird.Betterbird]
Branch=stable

[Flatpak Preinstall org.gimp.GIMP]
Branch=stable

[Flatpak Preinstall org.inkscape.Inkscape]
Branch=stable

[Flatpak Preinstall org.libreoffice.LibreOffice]
Branch=stable

[Flatpak Preinstall org.kde.okular]
Branch=stable

[Flatpak Preinstall org.onlyoffice.desktopeditors]
Branch=stable

[Flatpak Preinstall com.protonvpn.www]
Branch=stable

[Flatpak Preinstall org.rncbc.qpwgraph]
Branch=stable

[Flatpak Preinstall com.rawtherapee.RawTherapee]
Branch=stable

[Flatpak Preinstall org.remmina.Remmina]
Branch=stable

[Flatpak Preinstall com.rustdesk.RustDesk]
Branch=stable
