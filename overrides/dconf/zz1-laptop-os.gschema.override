# laptop-os dock defaults (Bluefin dash-to-dock, laptop-os favorites).
# Installed to /usr/share/glib-2.0/schemas/zz1-laptop-os.gschema.override by
# build/10-build.sh, then glib-compile-schemas. The zz1- prefix wins over
# Bluefin's zz0-bluefin-modifications override for favorite-apps only; all
# other Bluefin GNOME defaults stay untouched.
# New users only — existing ~/.config/dconf/user DBs shadow these defaults.
# Migrated users: run `ujust set-dock-layout` to apply to the live user DB.
# NOTE: brave-origin.desktop verified on-device (Brave Origin RPM ships its
# own .desktop name, not brave-browser.desktop). A wrong ID silently vanishes
# from the dock, so re-verify with `ls /usr/share/applications | grep -i brave`
# if the RPM ever renames it.
[org.gnome.shell]
favorite-apps = ['app.zen_browser.zen.desktop', 'librewolf.desktop', 'brave-origin.desktop', 'org.gnome.Nautilus.desktop', 'eu.betterbird.Betterbird.desktop', 'org.gnome.Ptyxis.desktop', 'org.gnome.gitlab.cheywood.Buffer.desktop']
